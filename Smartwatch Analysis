        "**2.1 Outlier Detection (IQR Method)**"
      ],
      "metadata": {
        "id": "BA1P10K6R7N5"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# 2.1 Outlier Detection (IQR Method)\n",
        "# ------------------------------------\n",
        "print(\"=== Outlier Detection ===\")\n",
        "numeric_cols = ['DailyStepCount', 'HeartRate_Min', 'HeartRate_Max',\n",
        "                'HeartRate_Avg', 'SleepDuration_Hours', 'SleepQualityScore',\n",
        "                'StressIndex', 'CalorieBurn', 'WeeklyHealthScore']\n",
        "\n",
        "for col in numeric_cols:\n",
        "    Q1 = df[col].quantile(0.25)\n",
        "    Q3 = df[col].quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "    outliers = df[(df[col] < Q1 - 1.5 * IQR) | (df[col] > Q3 + 1.5 * IQR)]\n",
        "    print(f\"{col}: {len(outliers)} outlier(s)\")"
      ],
