    {
      "cell_type": "code",
      "source": [
        "# 2.3 Risk Category Column\n",
        "# -------------------------\n",
        "def risk_category(row):\n",
        "    if row['StressIndex'] >= 70 and row['WeeklyHealthScore'] <= 70:\n",
        "        return 'High'\n",
        "    elif row['StressIndex'] >= 50 and row['WeeklyHealthScore'] <= 85:\n",
        "        return 'Moderate'\n",
        "    else:\n",
